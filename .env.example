# THE FORGED NEST — Environment
# ============================================================
NEST_BASE=$HOME/.nest
NEST_MODE=apex
NEST_VERSION=9.0.0

# LLM Provider
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_MAX_TOKENS=8192

# API Keys (uncomment and set your keys)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# Shadow Toolkit
SHADOW_WS_PORT=8766
SHADOW_CF_BYPASS=true

# Opencode
OPENCODE_CONFIG=$NEST_BASE/config/opencode.json
