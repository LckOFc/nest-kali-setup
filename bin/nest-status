#!/bin/bash
# THE FORGED NEST — Status Check
source "$HOME/.nest/.env" 2>/dev/null || true
echo "[NEST STATUS]"
echo "Base: $NEST_BASE"
echo "Mode: $NEST_MODE"
echo "Version: $NEST_VERSION"
echo "LLM: $LLM_PROVIDER / $LLM_MODEL"
echo ""
echo "Agents:"
ls -1 "$NEST_BASE/agents/" 2>/dev/null || echo "  (none)"
echo ""
echo "Skills:"
ls -1 "$NEST_BASE/skills/" 2>/dev/null || echo "  (none)"
echo ""
echo "Tools:"
ls -1 "$NEST_BASE/tools/" 2>/dev/null || echo "  (none)"
